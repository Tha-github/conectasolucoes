{
  "name": "conecta-solucoes-site",
  "version": "0.1.0",
  "private": true,
  "description": "Site institucional estático da Conecta Soluções (GitHub Pages).",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "dev": "node scripts/serve.mjs --watch",
    "serve": "node scripts/serve.mjs",
    "test": "node --test \"tests/**/*.test.mjs\"",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write .",
    "validate:content": "node scripts/validate-content.mjs",
    "content:import": "node scripts/import-content.mjs",
    "validate:publish": "node scripts/validate-publish.mjs",
    "docs:schema": "node scripts/schema-doc.mjs",
    "check": "npm run lint && npm test && npm run build"
  },
  "dependencies": {
    "@fontsource-variable/manrope": "5.3.0",
    "@fontsource-variable/outfit": "5.2.8"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "eslint": "10.13.0",
    "globals": "17.13.0",
    "prettier": "3.9.10"
  }
}
